# OmicSelector 2.0 - WebUI Docker Image
#
# Runs the Shiny WebUI via shiny::runApp().

FROM rocker/r-ver:4.4.0

LABEL maintainer="OmicSelector Team"
LABEL org.opencontainers.image.title="OmicSelector 2.0 WebUI"
LABEL org.opencontainers.image.description="Shiny WebUI for OmicSelector"
LABEL org.opencontainers.image.version="2.0.0"

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV TZ=UTC
ENV R_LIBS_USER=/usr/local/lib/R/site-library
ENV DEBIAN_FRONTEND=noninteractive
ENV RENV_CONFIG_AUTOLOADER_ENABLED=false
ENV OMICSELECTOR_ANALYSES_DIR=/OmicSelector/analyses

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    gfortran \
    make \
    cmake \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libfontconfig1-dev \
    libfreetype6-dev \
    libfribidi-dev \
    libharfbuzz-dev \
    libtiff-dev \
    libjpeg-dev \
    libpng-dev \
    libz-dev \
    libbz2-dev \
    liblzma-dev \
    libpcre2-dev \
    libgit2-dev \
    libglpk-dev \
    libgmp-dev \
    libgsl-dev \
    libcairo2-dev \
    libxt-dev \
    libx11-dev \
    pandoc \
    git \
    wget \
    curl \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN R -e "install.packages(c('remotes','shiny'), repos = 'https://cloud.r-project.org/')"

RUN mkdir -p /OmicSelector /OmicSelector/analyses

COPY . /OmicSelector

WORKDIR /OmicSelector

RUN R -e "remotes::install_deps(dependencies = TRUE)"
RUN R CMD INSTALL --no-multiarch --with-keep.source .

EXPOSE 3838

CMD ["R", "-e", "shiny::runApp('/OmicSelector/shiny/omicselector', host = '0.0.0.0', port = 3838)"]
