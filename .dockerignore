# Exclude renv - Docker uses its own dependency management
.Rprofile
renv/
renv.lock

# Exclude git artifacts
.git/
.github/

# Exclude dev files
.Rbuildignore
.Rproj.user/
*.Rproj

# Exclude test artifacts
tests/testthat/test-results/
check/

# Exclude documentation build artifacts
docs/
man/

# Exclude vignette outputs
vignettes/*.html
vignettes/*.pdf
