params {
 project_root = System.getenv('OMICSELECTOR_PAPER_ROOT') ?: System.getProperty('user.dir')
 max_cpus=4
 max_memory='24.GB'
 max_time='24.h'
 genome='GRCh38'
 mature="${params.project_root}/reference/mirbase_v22/hsa_mature.fa"
 hairpin="${params.project_root}/reference/mirbase_v22/hsa_hairpin.fa"
 fastp_min_length=17
 fastp_max_length=100
 genomes {
  'GRCh38' {
   fasta=null
   bowtie=null
   mirtrace_species='hsa'
   mirna_gtf="${params.project_root}/reference/mirbase_v22/hsa.gff3"
  }
 }
}
process.executor='local'
executor.queueSize=1
